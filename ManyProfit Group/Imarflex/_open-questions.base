filters:
  and:
    - type == "decision"
    - file.inFolder("ManyProfit Group/Imarflex/decisions")
formulas:
  status_icon: if(status == "open", "🟠", if(status == "decision-needed", "🟡", if(status == "resolved", "✅", "")))
properties:
  area:
    displayName: Area
  status:
    displayName: Status
  blocks:
    displayName: Blocks
  recommendation:
    displayName: My Recommendation
views:
  - type: table
    name: Open Questions
    filters:
      not:
        - status == "resolved"
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - formula.status_icon
      - area
      - recommendation
      - blocks
  - type: table
    name: Resolved
    filters:
      and:
        - status == "resolved"
    order:
      - file.name
      - area
      - recommendation
