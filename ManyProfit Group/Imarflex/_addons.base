filters:
  and:
    - type == "feature"
    - tier == "addon"
    - file.inFolder("ManyProfit Group/Imarflex/features")
formulas:
  decision_icon: if(decision == "suggested", "💡 Suggested", if(decision == "decision-needed", "🟡 Decide", if(decision == "confirmed", "✅ Confirmed", if(decision == "declined", "❌ Declined", if(decision == "must-have", "🔒 Must-have", "")))))
  status_icon: if(status == "shipped", "✅ Shipped", if(status == "in-progress", "🟡 In progress", if(status == "not-started", "⬜ Not started", if(status == "n-a", "➖ N/A", ""))))
properties:
  category:
    displayName: Category
  funnel-stage:
    displayName: Funnel
  decision:
    displayName: Decision
  status:
    displayName: Status
  priority:
    displayName: Priority
  phase:
    displayName: Phase
  best-phase:
    displayName: Best Phase
  setup-cost-hkd:
    displayName: Setup (HKD)
  monthly-cost-hkd:
    displayName: Monthly (HKD)
  metric:
    displayName: Expected Metric
  formula.decision_icon:
    displayName: Decision
  formula.status_icon:
    displayName: Status
views:
  - type: table
    name: All Add-ons
    groupBy:
      property: decision
      direction: ASC
    order:
      - file.name
      - formula.decision_icon
      - formula.status_icon
      - category
      - funnel-stage
      - priority
      - best-phase
      - setup-cost-hkd
      - monthly-cost-hkd
      - metric
    sort:
      - property: priority
        direction: ASC
  - type: table
    name: 💡 Suggested to Client
    filters:
      and:
        - decision == "suggested"
    groupBy:
      property: priority
      direction: ASC
    order:
      - file.name
      - formula.status_icon
      - category
      - funnel-stage
      - best-phase
      - setup-cost-hkd
      - monthly-cost-hkd
      - metric
    summaries:
      setup-cost-hkd: Sum
      monthly-cost-hkd: Sum
  - type: table
    name: 🟡 Decisions Needed
    filters:
      and:
        - decision == "decision-needed"
    order:
      - file.name
      - formula.status_icon
      - category
      - funnel-stage
      - best-phase
      - setup-cost-hkd
      - monthly-cost-hkd
      - metric
  - type: table
    name: ✅ Confirmed
    filters:
      and:
        - decision == "confirmed"
    order:
      - file.name
      - formula.status_icon
      - category
      - best-phase
      - setup-cost-hkd
      - monthly-cost-hkd
      - metric
    summaries:
      setup-cost-hkd: Sum
      monthly-cost-hkd: Sum
  - type: table
    name: 💰 Cost Summary
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - formula.decision_icon
      - setup-cost-hkd
      - monthly-cost-hkd
    sort:
      - property: monthly-cost-hkd
        direction: DESC
    summaries:
      setup-cost-hkd: Sum
      monthly-cost-hkd: Sum
  - type: cards
    name: By Funnel Stage
    groupBy:
      property: funnel-stage
      direction: ASC
    order:
      - file.name
      - formula.decision_icon
      - formula.status_icon
      - category
      - best-phase
      - setup-cost-hkd
      - monthly-cost-hkd
      - metric
