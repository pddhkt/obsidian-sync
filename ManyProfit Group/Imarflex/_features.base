filters:
  and:
    - type == "feature"
    - tier == "base"
    - file.inFolder("ManyProfit Group/Imarflex/features")
formulas:
  decision_icon: if(decision == "must-have", "🔒 Must-have", if(decision == "confirmed", "✅ Confirmed", if(decision == "decision-needed", "🟡 Decide", if(decision == "declined", "❌ Declined", ""))))
  status_icon: if(status == "shipped", "✅ Shipped", if(status == "in-progress", "🟡 In progress", if(status == "not-started", "⬜ Not started", if(status == "n-a", "➖ N/A", ""))))
properties:
  category:
    displayName: Category
  funnel-stage:
    displayName: Funnel
  decision:
    displayName: Decision
  status:
    displayName: Status
  priority:
    displayName: Priority
  phase:
    displayName: Phase
  metric:
    displayName: Expected Metric
  formula.decision_icon:
    displayName: Decision
  formula.status_icon:
    displayName: Status
views:
  - type: table
    name: All Foundation Features
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - formula.decision_icon
      - formula.status_icon
      - funnel-stage
      - priority
      - phase
      - metric
    sort:
      - property: priority
        direction: ASC
  - type: table
    name: 🚧 Build Status
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - formula.status_icon
      - formula.decision_icon
      - category
      - priority
      - phase
      - metric
  - type: table
    name: 🔒 Must-Have
    filters:
      and:
        - decision == "must-have"
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - formula.status_icon
      - funnel-stage
      - priority
      - phase
      - metric
  - type: table
    name: 🟡 Decisions Needed
    filters:
      and:
        - decision == "decision-needed"
    order:
      - file.name
      - formula.status_icon
      - category
      - funnel-stage
      - priority
      - metric
  - type: cards
    name: By Funnel Stage
    groupBy:
      property: funnel-stage
      direction: ASC
    order:
      - file.name
      - formula.decision_icon
      - formula.status_icon
      - category
      - priority
      - metric
